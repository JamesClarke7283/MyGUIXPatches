;;; GNU Guix --- Functional package management for GNU
;;;
;;; mullvad-vpn: the Mullvad VPN daemon and command-line client, built
;;; from source.
;;;
;;; Scope note: this package builds the Rust parts of
;;; <https://github.com/mullvad/mullvadvpn-app> only, namely
;;;
;;;   mullvad-daemon   the privileged daemon that owns the tunnel
;;;   mullvad          the command-line client ("mullvad status", ...)
;;;   mullvad-exclude  helper used for split tunnelling
;;;
;;; The Electron desktop GUI is *not* part of this package: upstream
;;; ships it as an npm workspace under desktop/, and Guix has no npm
;;; importer to turn that lockfile into package inputs.  See README.md.
;;;
;;; Dependency handling: the crate origins in (patches crates mullvad)
;;; are generated from upstream's Cargo.lock with
;;;
;;;   guix import crate mullvad-daemon -f Cargo.lock
;;;
;;; cargo-build-system accepts such plain crate-source origins directly
;;; (see crate-closure in (guix build-system cargo)), so no hand-written
;;; rust-* packages are needed and the build keeps working offline.
;;;
;;; Runtime note: the daemon spawns "wireguard-go" from its resource
;;; directory in order to create the tunnel.  Guix has no wireguard-go
;;; package yet, so you have to provide one and point the daemon at it
;;; with --resource-dir; see mullvad-vpn-service-type in
;;; (patches services vpn).

(define-module (patches vpn)
  #:use-module (guix base32)
  #:use-module (guix download)
  #:use-module (guix gexp)
  ;; (guix packages) exports its own `replace', the modify-inputs helper;
  ;; hide it so that the `replace' used inside the gexp's modify-phases
  ;; below unambiguously refers to the (guix build utils) phase helper.
  #:use-module ((guix packages) #:hide (replace))
  #:use-module (guix build-system cargo)
  #:use-module (guix build utils)
  #:use-module (guix licenses)
  #:use-module (gnu packages pkg-config)
  #:use-module (patches crates mullvad))

(define-public mullvad-vpn
  (package
    (name "mullvad-vpn")
    (version "2026.5")
    (source
     (origin
       (method url-fetch)
       (uri (string-append "https://github.com/mullvad/mullvadvpn-app/"
                           "archive/refs/tags/" version ".tar.gz"))
       (file-name (string-append name "-" version ".tar.gz"))
       (sha256
        (base32 "08sd6yh9l0m52d7sgpi5gwm6agw2rq6zz2gd8z93gw31imfk8cx1"))))
    (build-system cargo-build-system)
    (arguments
     (list
      ;; Every crate origin from upstream's Cargo.lock, generated by
      ;; tools/update-mullvad-crates.sh.  These are (label . origin)
      ;; pairs: a *package* cannot list raw origins in its inputs, but
      ;; expand-crate-sources turns each pair into a bag input, after
      ;; which unpack-rust-crates expands the tarball into the vendor
      ;; directory and patch-cargo-checksums stubs the
      ;; .cargo-checksum.json files.  cargo-build-system prints a
      ;; deprecation warning for #:cargo-inputs; it is expected and
      ;; harmless here.
      #:cargo-inputs mullvad-crate-inputs
      ;; Build only the three workspace members we actually ship.
      ;; --locked is important: the vendor directory is derived from
      ;; Cargo.lock, so cargo must not try to re-resolve anything.
      #:cargo-build-flags
      '("--release" "--locked"
        "--package" "mullvad-daemon"
        "--package" "mullvad-cli"
        "--package" "mullvad-exclude")
      ;; Upstream's test suite wants a live account and a real tunnel.
      #:tests? #f
      ;; Do not install the crate sources into the output.
      #:install-source? #f
      #:phases
      #~(modify-phases %standard-phases
          ;; cargo-build-system's own 'install phase runs
          ;; `cargo install --path ... --features ""', which is
          ;; needlessly fragile for a multi-package workspace (and
          ;; rebuilds everything).  Copy the binaries cargo already
          ;; produced instead.
          (replace 'install
            (lambda* (#:key outputs #:allow-other-keys)
              (let* ((out (assoc-ref outputs "out"))
                     (bin (string-append out "/bin")))
                (mkdir-p bin)
                (for-each (lambda (binary)
                            (install-file
                             (string-append "target/release/" binary)
                             bin))
                          '("mullvad-daemon"
                            "mullvad"
                            "mullvad-exclude"))))))))
    ;; Not strictly needed by the crates we build, but several -sys
    ;; crates in the workspace look for pkg-config at configure time.
    (native-inputs
     (list pkg-config))
    (synopsis "Mullvad VPN daemon and command-line client")
    (description
     "This package provides the Rust components of the Mullvad VPN client:

@itemize
@item @command{mullvad-daemon}, the privileged daemon that manages the
WireGuard tunnel, DNS settings and firewall rules;
@item @command{mullvad}, the command-line client used to log in, select
relays and query the daemon's status;
@item @command{mullvad-exclude}, the helper used for split tunnelling.
@end itemize

The Electron desktop application is not included; see the README for
the status of the GUI.  Creating a tunnel additionally requires a
@command{wireguard-go} binary in the daemon's resource directory.")
    (home-page "https://mullvad.net")
    (license gpl3)))
