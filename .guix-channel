;; -*- mode: scheme; -*-
;; Guix channel declaration for this repository.
;;
;; The modules exported by this channel live under the "modules"
;; directory; a file such as "modules/patches/vpn.scm" provides the
;; module (patches vpn).
;;
;; This channel depends on nonguix: several package modules use
;; (nonguix build-system chromium-binary) and (nonguix packages electron).
;; Guix only puts a channel's declared dependencies on the module load path
;; when compiling it, so without this declaration `guix pull' fails with
;; "no code for module (nonguix build-system chromium-binary)".
(channel
 (version 0)
 (directory "modules")
 (dependencies
  (channel
   (name nonguix)
   (url "https://gitlab.com/nonguix/nonguix")
   (introduction
    (channel-introduction
     (version 0)
     (commit "897c1a470da759236cc11798f4e0a5f7d4d59fbc")
     (signer "2A39 3FFF 68F4 EF7A 3D29  12AF 6F51 20A0 22FB B2D5"))))))
